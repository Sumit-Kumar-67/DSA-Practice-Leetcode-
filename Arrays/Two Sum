/*
    LeetCode #1 - Two Sum

    Difficulty: Easy
    Topic: Array, Hash Table,Two Pointer
    Pattern: Hashing

    Time Complexity: O(n)
    Space Complexity: O(n)
*/
class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {

        int n = nums.size();

                    for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                if (nums[i] + nums[j] == target) {
                    return {i, j};
                }
            }
        }
        return {};
    }
};
